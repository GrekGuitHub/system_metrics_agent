# Copier ce fichier en .env (jamais versionné) puis adapter les valeurs.

# URL de réception des métriques.
# Hors Docker : http://127.0.0.1:8000/metrics
# Avec Docker Compose, cette valeur est remplacée par http://api:8000/metrics
METRICS_ENDPOINT=http://127.0.0.1:8000/metrics

# Intervalle entre deux collectes, en secondes
COLLECTION_INTERVAL=5

# Timeout HTTP en secondes
REQUEST_TIMEOUT=5

# Port publié sur la machine pour l'API (Docker Compose)
API_PORT=8000